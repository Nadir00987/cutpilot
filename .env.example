# CutPilot AI — environment configuration
# Copy to `.env` and fill in the secrets. NEVER commit a filled `.env`.
# cp .env.example .env

# ---------------------------------------------------------------- database
# SQLAlchemy URL for the app. In docker-compose the service name `postgres`
# is used as host; locally use localhost.
DATABASE_URL=postgresql+psycopg2://cutpilot:cutpilot@localhost:5432/cutpilot
# Raw postgres pieces used by docker-compose to create the DB user/db.
POSTGRES_USER=cutpilot
POSTGRES_PASSWORD=cutpilot
POSTGRES_DB=cutpilot

# ------------------------------------------------------------------ redis
# Used for caching + Celery broker/result backend (worker overrides db index).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------------------------------------------------------------------- auth
# Secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------------------- billing
# Stripe is wired for TEST MODE only: the checkout endpoints and webhook
# handlers exist, but credits are granted through a test-mode stub.
# The credit-deduction logic (1 credit = 1 minute of processed video) is
# REAL and enforced in the API — see ACCEPTANCE.md "Honest gaps".
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_MODE=test

# How many credits one minute of processed video costs (1 credit = 1 min).
CREDITS_PER_MINUTE=1.0
# Credits granted to every new signup (lets the e2e test run for free).
FREE_SIGNUP_CREDITS=30

# ------------------------------------------------------------- stock media
# Pexels / Pixabay API keys. Optional: the B-roll engine matches keywords to
# stock footage ONLY when a key is present; otherwise it uses the user's
# uploaded B-roll and AI B-roll prompt suggestions.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ------------------------------------------------------------------ vision
# Frame vision analysis is pluggable. Leave empty to run audio-only analysis
# (graceful fallback — noted in the UI and in analysis.json).
VISION_API_URL=
VISION_API_KEY=
VISION_API_MODEL=gpt-4o-mini
# Seconds between sampled frames sent to the vision model.
VISION_FRAME_INTERVAL_SEC=10

# --------------------------------------------------------------------- llm
# LLM used for the edit-plan brain (OpenAI-compatible endpoint).
# If unset, the planner runs rules-only (still a real edit plan).
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=gpt-4o-mini
# Temperature kept low so edits stay deterministic and auditable.
LLM_TEMPERATURE=0.2

# --------------------------------------------------------------------- tts
# TTS provider for the voiceover/dubbing feature. Supported: "openai",
# "elevenlabs", or "none". "none" returns a stub response with a real code
# path (see app/services/voiceover.py).
TTS_PROVIDER=none
TTS_API_KEY=
TTS_VOICE=default

# ------------------------------------------------------------------- email
# Provider for password-reset emails: "smtp", "sendgrid", or "none" (logs).
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cutpilot.ai

# ------------------------------------------------------------- whisper stt
# faster-whisper model size: tiny, base, small, medium, large-v3.
# Use `tiny` on low-memory VMs (the e2e script does this automatically).
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------- analysis tunables (sec)
# Silences longer than this are flagged for removal in analysis.
SILENCE_THRESHOLD_SEC=0.8
# Min word-confidence below which a word is flagged low-confidence.
LOW_CONFIDENCE_THRESHOLD=0.5
# Padding snapped around cut points so we never cut mid-word.
CUT_PADDING_MS=100

# -------------------------------------------------------------- app urls
# Public URL of the frontend (used in email links, shareable render links).
FRONTEND_URL=http://localhost:3000
# Base URL of the API, baked into the frontend build (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Directory for uploads/renders/assets/thumbnails (overridden in compose).
STORAGE_DIR=./storage

# ------------------------------------------------------------------ misc
LOG_LEVEL=info
