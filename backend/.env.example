# CutPilot AI — backend environment. Copy to .env and fill in.
# NEVER commit a real .env (it's gitignored).

# --- Database ---------------------------------------------------------------
# Local default is SQLite (zero services). For docker-compose use postgres:
# DATABASE_URL=postgresql://cutpilot:cutpilot@postgres:5432/cutpilot
DATABASE_URL=sqlite:///./cutpilot.db

# --- Queue ------------------------------------------------------------------
# Redis for Celery. If unreachable, the backend automatically falls back to
# an in-process ThreadPoolExecutor — no config change needed.
REDIS_URL=redis://localhost:6379/0

# --- Auth -------------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Storage / frontend ------------------------------------------------------
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Billing (Stripe) --------------------------------------------------------
# Leave unset to run checkout/webhook in stub mode (dev-friendly).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# --- Stock media --------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- AI services (OpenAI-compatible endpoints; Worker B's pipeline reads these)
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# --- TTS (optional voiceover track) -------------------------------------------
TTS_PROVIDER=
TTS_API_KEY=
TTS_API_URL=

# --- Email --------------------------------------------------------------------
# console = print reset links to the server log (dev default)
EMAIL_PROVIDER=console

# --- Pipeline tuning -----------------------------------------------------------
SILENCE_THRESHOLD_SEC=0.8
CREDITS_PER_MINUTE=1.0
WHISPER_MODEL=base
